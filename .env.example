# Optional: the app runs locally without any environment variables.
# Copy this file to .env.local ONLY when enabling a Firebase cloud workspace.
# VITE_* variables are public browser configuration, not server secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Keep false for real Firebase projects. See README for isolated emulator setup.
VITE_USE_EMULATORS=false
